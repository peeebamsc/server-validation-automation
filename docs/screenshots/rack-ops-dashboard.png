/* ==========================================================================
   Cloaked Design System 4.0 — Colors & Typography
   Vendored snapshot of the design-repo registry token source.
   ========================================================================== */

/* ----- Fonts ---------------------------------------------------------- */

/* STK Bureau Sans — Dashboard & Brand workhorse */
@font-face { font-family: "STK Bureau Sans"; font-weight: 300; font-style: normal;
  src: url("chrome-extension://oppdbdefikkkihgbliidckokhgcmmiga/fonts/STKBureauSans-Book.ttf") format("truetype"); font-display: swap; }
@font-face { font-family: "STK Bureau Sans"; font-weight: 400; font-style: normal;
  src: url("chrome-extension://oppdbdefikkkihgbliidckokhgcmmiga/fonts/STKBureauSans-Regular.ttf") format("truetype"); font-display: swap; }
@font-face { font-family: "STK Bureau Sans"; font-weight: 500; font-style: normal;
  src: url("chrome-extension://oppdbdefikkkihgbliidckokhgcmmiga/fonts/STKBureauSans-Medium.ttf") format("truetype"); font-display: swap; }
@font-face { font-family: "STK Bureau Sans"; font-weight: 600; font-style: normal;
  src: url("chrome-extension://oppdbdefikkkihgbliidckokhgcmmiga/fonts/STKBureauSans-SemiBold.ttf") format("truetype"); font-display: swap; }
@font-face { font-family: "STK Bureau Sans"; font-weight: 700; font-style: normal;
  src: url("chrome-extension://oppdbdefikkkihgbliidckokhgcmmiga/fonts/STKBureauSans-Bold.ttf") format("truetype"); font-display: swap; }

:host {
  /* ======================================================================
     FONT FAMILIES
     One face per surface. iOS uses the system stack; everything else
     ships its own file.
     ====================================================================== */
  --font-ios: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", system-ui, sans-serif;
  --font-android: "Roboto", system-ui, sans-serif;
  --font-dashboard: "STK Bureau Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --font-brand: "STK Bureau Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --font-serif: "Simula", "Iowan Old Style", Georgia, serif;
  --font-website: "Simula", "Iowan Old Style", Georgia, serif;
  --font-mono: "SF Mono", "JetBrains Mono", ui-monospace, Menlo, monospace;

  /* Figma Typography/Typeface variables */
  --typeface-font-family-ios: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", system-ui, sans-serif;
  --typeface-font-family-android: "Roboto", system-ui, sans-serif;
  --typeface-font-family-dashboard: "STK Bureau Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --typeface-font-family-website: "Simula", "Iowan Old Style", Georgia, serif;

  /* Figma Typography default mode variables */
  --size-big-heading: 48px;
  --size-body: 17px;
  --size-callout: 16px;
  --size-caption-1: 12px;
  --size-caption-2: 11px;
  --size-footnote: 13px;
  --size-headline: 17px;
  --size-large-title: 34px;
  --size-legal: 10px;
  --size-numbers: 70px;
  --size-subhead: 15px;
  --size-title-1: 28px;
  --size-title-2: 22px;
  --size-title-3: 20px;

  --line-height-big-heading: 56px;
  --line-height-body: 22px;
  --line-height-callout: 21px;
  --line-height-caption-1: 16px;
  --line-height-caption-2: 13px;
  --line-height-footnote: 18px;
  --line-height-headline: 22px;
  --line-height-large-title: 41px;
  --line-height-legal: 12px;
  --line-height-numbers: 76px;
  --line-height-subhead: 20px;
  --line-height-title-1: 34px;
  --line-height-title-2: 28px;
  --line-height-title-3: 25px;

  --letter-spacing-big-heading: 0.3px;
  --letter-spacing-body: -0.43px;
  --letter-spacing-callout: -0.31px;
  --letter-spacing-caption-1: 0px;
  --letter-spacing-caption-2: 0.06px;
  --letter-spacing-footnote: -0.08px;
  --letter-spacing-headline: -0.43px;
  --letter-spacing-large-title: 0.4px;
  --letter-spacing-legal: 0px;
  --letter-spacing-subhead: -0.24px;
  --letter-spacing-title-1: 0.4px;
  --letter-spacing-title-2: -0.24px;
  --letter-spacing-title-3: -0.43px;

  --weight-book: 300;
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ======================================================================
     COLOR PRIMITIVES — Neutrals
     21-step neutral ramp. Use semantic tokens below; only reach into
     primitives when the semantic layer genuinely can't cover a case.
     ====================================================================== */
  --neutral-0:    #FFFFFF;
  --neutral-50:   #F7F7F7;
  --neutral-100:  #F2F2F2;
  --neutral-150-border-1: #E5E5E5;
  --neutral-200-border-2: #D9D9D9;
  --neutral-250:  #CCCCCC;
  --neutral-300:  #B3B3B3;
  --neutral-350:  #A6A6A6;
  --neutral-400:  #999999;
  --neutral-450:  #8C8C8C;
  --neutral-500:  #808080;
  --neutral-550:  #737373;
  --neutral-600:  #666666;
  --neutral-650:  #595959;
  --neutral-700:  #4C4C4C;
  --neutral-750:  #404040;
  --neutral-800:  #333333;
  --neutral-850:  #262626;
  --neutral-900:  #1A1A1A;
  --neutral-950:  #0D0D0D;
  --neutral-1000: #000000;

  /* ======================================================================
     COLOR PRIMITIVES — Live Figma variables
     Source of truth: Figma /Color/Color-Variables. CSS variable names are
     Figma names converted to kebab-case.
     ====================================================================== */

  /* Brand */
  --brand-100: #FFE9E0;
  --brand-200: #FFDBCC;
  --brand-300-cloaked: #FF550C;
  --brand-400: #CC3D00;

  /* Blue */
  --blue-100-subtle: #B2E0FF;
  --blue-200: #2A9AE8;
  --blue-300: #3F7AEF;

  /* Purple */
  --purple-100-subtle: #DCD0FF;
  --purple-200: #A474FF;
  --purple-300: #635EF9;

  /* Green */
  --green-100-subtle: #C4E7D0;
  --green-200: #62C081;
  --green-300: #009933;

  /* Red */
  --red-100-subtle: #FCBEBE;
  --red-200: #F36669;
  --red-300: #C53535;

  /* Marketing palette */
  --marketing-100: #FBF8EF;
  --marketing-200: #F3EFE2;
  --marketing-300: #E9E6DA;
  --marketing-400: #A09C8F;
  --marketing-500: #454030;
  --marketing-600: #292519;
  --marketing-700: #201C0F;
  --marketing-800: #1C180B;
  --marketing-900: #130F02;

  /* Status */
  --status-positive: #009933;
  --status-negative: #EC4545;
  --status-warning: #F27F0D;

  /* Surfaces */
  --surface-l0-background: var(--neutral-50);
  --surface-l1-card: var(--neutral-0);
  --surface-l2-white-black: var(--neutral-0);
  --surface-l3: #FFFFFF;
  --surface-l4: #FFFFFF;
  --surface-l5: #FFFFFF;
  --surface-l6: #FFFFFF;

  /* Overlays */
  --overlay-black-base-0-gradient-stop: rgba(0, 0, 0, 0);
  --overlay-black-base-5: rgba(0, 0, 0, 0.05);
  --overlay-black-base-10: rgba(0, 0, 0, 0.1);
  --overlay-black-base-15: rgba(0, 0, 0, 0.15);
  --overlay-black-base-20: rgba(0, 0, 0, 0.2);
  --overlay-black-base-30: rgba(0, 0, 0, 0.3);
  --overlay-black-base-40: rgba(0, 0, 0, 0.4);
  --overlay-black-base-50: rgba(0, 0, 0, 0.5);
  --overlay-black-base-60: rgba(0, 0, 0, 0.6);
  --overlay-black-base-70: rgba(0, 0, 0, 0.7);
  --overlay-black-base-80: rgba(0, 0, 0, 0.8);
  --overlay-black-base-90: rgba(0, 0, 0, 0.9);
  --overlay-black-base-100-gradient-stop: rgba(0, 0, 0, 1);
  --overlay-white-base-0-gradient-stop: rgba(255, 255, 255, 0);
  --overlay-white-base-5: rgba(255, 255, 255, 0.05);
  --overlay-white-base-10: rgba(255, 255, 255, 0.1);
  --overlay-white-base-15: rgba(255, 255, 255, 0.15);
  --overlay-white-base-20: rgba(255, 255, 255, 0.2);
  --overlay-white-base-30: rgba(255, 255, 255, 0.3);
  --overlay-white-base-40: rgba(255, 255, 255, 0.4);
  --overlay-white-base-50: rgba(255, 255, 255, 0.5);
  --overlay-white-base-60: rgba(255, 255, 255, 0.6);
  --overlay-white-base-70: rgba(255, 255, 255, 0.7);
  --overlay-white-base-80: rgba(255, 255, 255, 0.8);
  --overlay-white-base-90: rgba(255, 255, 255, 0.9);
  --overlay-white-base-100-gradient-stop: rgba(255, 255, 255, 1);
  --overlay-status-positive-10: rgba(0, 153, 51, 0.1);
  --overlay-status-positive-20: rgba(0, 153, 51, 0.2);
  --overlay-status-negative-10: rgba(236, 69, 69, 0.1);
  --overlay-status-negative-20: rgba(236, 69, 69, 0.2);
  --overlay-status-warning-10: rgba(242, 127, 13, 0.1);
  --overlay-status-warning-20: rgba(242, 127, 13, 0.2);

  /* ======================================================================
     SEMANTIC TOKENS — Light mode (default)
     These are what you use in components. They remap under
     `[data-theme="dark"]` below; rename the primitive, not these.
     Source of truth: Figma /Color/Color-Variables.
     ====================================================================== */

  /* Surfaces — the stack of paper you build on */
  --bg-canvas:       var(--surface-l1-card);  /* app background, dashboard */
  --bg-cream:        var(--marketing-200);  /* iOS warm background */
  --bg-subtle:       var(--surface-l0-background);  /* secondary surface (cards on canvas) */
  --bg-muted:        var(--neutral-100);  /* tertiary surface, wells */
  --bg-inverse:      var(--neutral-1000);  /* dark CTA, tooltips */
  --bg-scrim:        var(--overlay-black-base-50);
  --bg-overlay-soft: var(--overlay-black-base-5);
  --bg-overlay-med:  var(--overlay-black-base-10);

  /* Foreground */
  --fg-default:      var(--neutral-1000);  /* primary text */
  --fg-strong:       var(--neutral-900);  /* headings */
  --fg-muted:        var(--neutral-850);  /* body */
  --fg-subtle:       var(--neutral-650);  /* captions */
  --fg-disabled:     var(--neutral-450);
  --fg-placeholder:  var(--neutral-350);
  --fg-inverse:      var(--neutral-0);
  --fg-link:         var(--blue-300);

  /* Borders */
  --border-default:  var(--neutral-150-border-1);
  --border-strong:   var(--neutral-250);
  --border-subtle:   var(--neutral-100);
  --border-focus:    var(--blue-300);

  /* Accent roles */
  --accent-primary:       var(--brand-300-cloaked);
  --accent-primary-hover: var(--brand-300-cloaked);
  --accent-primary-press: var(--brand-400);
  --accent-primary-fg:    var(--neutral-0);
  --accent-secondary:     var(--neutral-1000);  /* Black — the "confirm" color */
  --accent-secondary-fg:  var(--neutral-0);

  /* State */
  --state-success:  var(--status-positive);
  --state-success-bg: var(--overlay-status-positive-10);
  --state-danger:   var(--status-negative);
  --state-danger-bg: var(--overlay-status-negative-10);
  --state-warning:  var(--status-warning);
  --state-warning-bg: var(--overlay-status-warning-10);
  --state-info:     var(--blue-200);
  --state-info-bg:  rgba(42, 154, 232, 0.1);

  /* Iconographic / data accents — used on stat numerals (the "165"
     blue), data-monitoring rows, and the floating info icon-button.
     Aliased to the existing primitive so the role stays canonical. */
  --accent-blue-bold:  var(--blue-300);

  /* Soft orange wash — backgrounds for "Critical" hero cards and
     orange-tinted icon plates. No analog in primitives, so it ships
     as an explicit value here. */
  --brand-orange-tint: #FFE9E0;
}

/* ==========================================================================
   DARK THEME
   Same primitives, inverted semantics. Triggered by either:
     html[data-theme="dark"]   — explicit opt-in
     @media (prefers-color-scheme: dark) with html[data-theme="auto"]
   Default is light; no media override unless you opt in.
   Source of truth: Figma /Color/Color-Variables [SECTION]--Dark.
   ========================================================================== */
:host([data-theme="dark"]) {
  --neutral-0:    #000000;
  --neutral-50:   #0D0D0D;
  --neutral-100:  #1A1A1A;
  --neutral-150-border-1: #262626;
  --neutral-200-border-2: #333333;
  --neutral-250:  #404040;
  --neutral-300:  #4C4C4C;
  --neutral-350:  #595959;
  --neutral-400:  #666666;
  --neutral-450:  #737373;
  --neutral-500:  #808080;
  --neutral-550:  #8C8C8C;
  --neutral-600:  #999999;
  --neutral-650:  #A6A6A6;
  --neutral-700:  #B3B3B3;
  --neutral-750:  #CCCCCC;
  --neutral-800:  #D9D9D9;
  --neutral-850:  #E5E5E5;
  --neutral-900:  #F2F2F2;
  --neutral-950:  #F7F7F7;
  --neutral-1000: #FFFFFF;

  --brand-100: #210B02;
  --brand-200: #431906;
  --brand-300-cloaked: #FF6625;
  --brand-400: #D0470C;

  --blue-100-subtle: #1D415A;
  --blue-200: #30A2F2;
  --blue-300: #4782F7;
  --purple-100-subtle: #2B166C;
  --purple-200: #AC80FF;
  --purple-300: #6E69FF;
  --green-100-subtle: #004116;
  --green-200: #6BC689;
  --green-300: #01AE3A;
  --red-100-subtle: #691C1C;
  --red-200: #FF7376;
  --red-300: #DD4141;

  --marketing-100: #130F02;
  --marketing-200: #1C180B;
  --marketing-300: #201C0F;
  --marketing-400: #292519;
  --marketing-500: #454030;
  --marketing-600: #A09C8F;
  --marketing-700: #E9E6DA;
  --marketing-800: #F3EFE2;
  --marketing-900: #FBF8EF;

  --status-positive: #31AD5A;
  --status-negative: #EE5555;
  --status-warning: #F4983B;

  --surface-l0-background: var(--neutral-50);
  --surface-l1-card: var(--neutral-100);
  --surface-l2-white-black: var(--neutral-0);
  --surface-l3: var(--neutral-150-border-1);
  --surface-l4: var(--neutral-200-border-2);
  --surface-l5: var(--neutral-250);
  --surface-l6: var(--neutral-300);

  --overlay-black-base-0-gradient-stop: rgba(255, 255, 255, 0);
  --overlay-black-base-5: rgba(255, 255, 255, 0.05);
  --overlay-black-base-10: rgba(255, 255, 255, 0.1);
  --overlay-black-base-15: rgba(255, 255, 255, 0.15);
  --overlay-black-base-20: rgba(255, 255, 255, 0.2);
  --overlay-black-base-30: rgba(255, 255, 255, 0.3);
  --overlay-black-base-40: rgba(255, 255, 255, 0.4);
  --overlay-black-base-50: rgba(255, 255, 255, 0.5);
  --overlay-black-base-60: rgba(255, 255, 255, 0.6);
  --overlay-black-base-70: rgba(255, 255, 255, 0.7);
  --overlay-black-base-80: rgba(255, 255, 255, 0.8);
  --overlay-black-base-90: rgba(255, 255, 255, 0.9);
  --overlay-black-base-100-gradient-stop: #FFFFFF;

  --overlay-white-base-0-gradient-stop: rgba(0, 0, 0, 0);
  --overlay-white-base-5: rgba(0, 0, 0, 0.05);
  --overlay-white-base-10: rgba(0, 0, 0, 0.1);
  --overlay-white-base-15: rgba(0, 0, 0, 0.15);
  --overlay-white-base-20: rgba(0, 0, 0, 0.2);
  --overlay-white-base-30: rgba(0, 0, 0, 0.3);
  --overlay-white-base-40: rgba(0, 0, 0, 0.4);
  --overlay-white-base-50: rgba(0, 0, 0, 0.5);
  --overlay-white-base-60: rgba(0, 0, 0, 0.6);
  --overlay-white-base-70: rgba(0, 0, 0, 0.7);
  --overlay-white-base-80: rgba(0, 0, 0, 0.8);
  --overlay-white-base-90: rgba(0, 0, 0, 0.9);
  --overlay-white-base-100-gradient-stop: #000000;

  --overlay-status-positive-10: rgba(49, 173, 90, 0.3);
  --overlay-status-positive-20: rgba(49, 173, 90, 0.4);
  --overlay-status-negative-10: rgba(238, 85, 85, 0.3);
  --overlay-status-negative-20: rgba(238, 85, 85, 0.4);
  --overlay-status-warning-10: rgba(244, 152, 59, 0.3);
  --overlay-status-warning-20: rgba(244, 152, 59, 0.4);

  --bg-canvas:       var(--surface-l1-card);
  --bg-cream:        var(--marketing-200);
  --bg-subtle:       var(--surface-l0-background);
  --bg-muted:        var(--neutral-100);
  --bg-inverse:      var(--neutral-1000);
  --bg-scrim:        var(--overlay-black-base-70);
  --bg-overlay-soft: var(--overlay-black-base-5);
  --bg-overlay-med:  var(--overlay-black-base-10);

  --fg-default:      var(--neutral-1000);
  --fg-strong:       var(--neutral-1000);
  --fg-muted:        var(--neutral-850);
  --fg-subtle:       var(--neutral-650);
  --fg-disabled:     var(--neutral-450);
  --fg-placeholder:  var(--neutral-550);
  --fg-inverse:      var(--neutral-0);
  --fg-link:         var(--blue-300);

  --border-default:  var(--neutral-150-border-1);
  --border-strong:   var(--neutral-250);
  --border-subtle:   var(--neutral-100);
  --border-focus:    var(--blue-300);

  --accent-primary:       var(--brand-300-cloaked);
  --accent-primary-hover: var(--brand-300-cloaked);
  --accent-primary-press: var(--brand-400);
  --accent-primary-fg:    var(--neutral-0);
  --accent-secondary:     var(--neutral-1000);
  --accent-secondary-fg:  var(--neutral-0);

  --state-success:     var(--status-positive);
  --state-success-bg:  var(--overlay-status-positive-10);
  --state-danger:      var(--status-negative);
  --state-danger-bg:   var(--overlay-status-negative-10);
  --state-warning:     var(--status-warning);
  --state-warning-bg:  var(--overlay-status-warning-10);
  --state-info:        var(--blue-200);
  --state-info-bg:     rgba(48, 162, 242, 0.3);

  /* iOS-kit dark variants of the new semantic accents added 2026-05-27. */
  --accent-blue-bold:  var(--blue-300);
  --brand-orange-tint: rgba(255, 85, 12, 0.12);

  /* Shadows are effectively invisible on #000; replace w/ subtle white haloes */
  --shadow-xs:  0 0 0 1px rgba(255, 255, 255, 0.04);
  --shadow-sm:  0 2px 8px rgba(0, 0, 0, 0.5);
  --shadow-md:  0 5px 20px rgba(0, 0, 0, 0.6);
  --shadow-lg:  0 8px 32px rgba(0, 0, 0, 0.7);
  --shadow-xl:  0 16px 48px rgba(0, 0, 0, 0.8);
  --shadow-focus: 0 0 0 3px rgba(71, 130, 247, 0.4);
}

/* Opt-in auto mode: follow the OS when html[data-theme="auto"] */
@media (prefers-color-scheme: dark) {
  :host([data-theme="auto"]) {
    --neutral-0: #000000; --neutral-50: #0D0D0D; --neutral-100: #1A1A1A;
    --neutral-150-border-1: #262626; --neutral-200-border-2: #333333;
    --neutral-250: #404040; --neutral-300: #4C4C4C; --neutral-350: #595959;
    --neutral-400: #666666; --neutral-450: #737373; --neutral-500: #808080;
    --neutral-550: #8C8C8C; --neutral-600: #999999; --neutral-650: #A6A6A6;
    --neutral-700: #B3B3B3; --neutral-750: #CCCCCC; --neutral-800: #D9D9D9;
    --neutral-850: #E5E5E5; --neutral-900: #F2F2F2; --neutral-950: #F7F7F7;
    --neutral-1000: #FFFFFF;
    --brand-100: #210B02; --brand-200: #431906;
    --brand-300-cloaked: #FF6625; --brand-400: #D0470C;
    --blue-100-subtle: #1D415A; --blue-200: #30A2F2; --blue-300: #4782F7;
    --purple-100-subtle: #2B166C; --purple-200: #AC80FF; --purple-300: #6E69FF;
    --green-100-subtle: #004116; --green-200: #6BC689; --green-300: #01AE3A;
    --red-100-subtle: #691C1C; --red-200: #FF7376; --red-300: #DD4141;
    --marketing-100: #130F02; --marketing-200: #1C180B; --marketing-300: #201C0F;
    --marketing-400: #292519; --marketing-500: #454030; --marketing-600: #A09C8F;
    --marketing-700: #E9E6DA; --marketing-800: #F3EFE2; --marketing-900: #FBF8EF;
    --status-positive: #31AD5A; --status-negative: #EE5555; --status-warning: #F4983B;
    --surface-l0-background: var(--neutral-50); --surface-l1-card: var(--neutral-100);
    --surface-l2-white-black: var(--neutral-0); --surface-l3: var(--neutral-150-border-1);
    --surface-l4: var(--neutral-200-border-2); --surface-l5: var(--neutral-250);
    --surface-l6: var(--neutral-300);
    --overlay-black-base-0-gradient-stop: rgba(255,255,255,0);
    --overlay-black-base-5: rgba(255,255,255,0.05); --overlay-black-base-10: rgba(255,255,255,0.1);
    --overlay-black-base-15: rgba(255,255,255,0.15); --overlay-black-base-20: rgba(255,255,255,0.2);
    --overlay-black-base-30: rgba(255,255,255,0.3); --overlay-black-base-40: rgba(255,255,255,0.4);
    --overlay-black-base-50: rgba(255,255,255,0.5); --overlay-black-base-60: rgba(255,255,255,0.6);
    --overlay-black-base-70: rgba(255,255,255,0.7); --overlay-black-base-80: rgba(255,255,255,0.8);
    --overlay-black-base-90: rgba(255,255,255,0.9); --overlay-black-base-100-gradient-stop: #FFFFFF;
    --overlay-white-base-0-gradient-stop: rgba(0,0,0,0);
    --overlay-white-base-5: rgba(0,0,0,0.05); --overlay-white-base-10: rgba(0,0,0,0.1);
    --overlay-white-base-15: rgba(0,0,0,0.15); --overlay-white-base-20: rgba(0,0,0,0.2);
    --overlay-white-base-30: rgba(0,0,0,0.3); --overlay-white-base-40: rgba(0,0,0,0.4);
    --overlay-white-base-50: rgba(0,0,0,0.5); --overlay-white-base-60: rgba(0,0,0,0.6);
    --overlay-white-base-70: rgba(0,0,0,0.7); --overlay-white-base-80: rgba(0,0,0,0.8);
    --overlay-white-base-90: rgba(0,0,0,0.9); --overlay-white-base-100-gradient-stop: #000000;
    --overlay-status-positive-10: rgba(49,173,90,0.3); --overlay-status-positive-20: rgba(49,173,90,0.4);
    --overlay-status-negative-10: rgba(238,85,85,0.3); --overlay-status-negative-20: rgba(238,85,85,0.4);
    --overlay-status-warning-10: rgba(244,152,59,0.3); --overlay-status-warning-20: rgba(244,152,59,0.4);
    --bg-canvas: var(--surface-l1-card); --bg-cream: var(--marketing-200);
    --bg-subtle: var(--surface-l0-background); --bg-muted: var(--neutral-100);
    --bg-inverse: var(--neutral-1000); --bg-scrim: var(--overlay-black-base-70);
    --bg-overlay-soft: var(--overlay-black-base-5); --bg-overlay-med: var(--overlay-black-base-10);
    --fg-default: var(--neutral-1000); --fg-strong: var(--neutral-1000);
    --fg-muted: var(--neutral-850); --fg-subtle: var(--neutral-650);
    --fg-disabled: var(--neutral-450); --fg-placeholder: var(--neutral-550);
    --fg-inverse: var(--neutral-0); --fg-link: var(--blue-300);
    --border-default: var(--neutral-150-border-1); --border-strong: var(--neutral-250);
    --border-subtle: var(--neutral-100); --border-focus: var(--blue-300);
    --accent-primary: var(--brand-300-cloaked); --accent-primary-hover: var(--brand-300-cloaked);
    --accent-primary-press: var(--brand-400); --accent-primary-fg: var(--neutral-0);
    --accent-secondary: var(--neutral-1000); --accent-secondary-fg: var(--neutral-0);
    --state-success: var(--status-positive); --state-success-bg: var(--overlay-status-positive-10);
    --state-danger: var(--status-negative); --state-danger-bg: var(--overlay-status-negative-10);
    --state-warning: var(--status-warning); --state-warning-bg: var(--overlay-status-warning-10);
    --state-info: var(--blue-200); --state-info-bg: rgba(48,162,242,0.3);
  }
}

/* The :root block below continues with universal (light+dark shared) tokens */
:host {

  /* ======================================================================
     CORNER RADIUS
     Cloaked leans on generous but not balloon-y corners. Cards get 16px;
     buttons are pill-shape (full) on mobile, 12px on desktop.
     ====================================================================== */
  --radius-none: 0;
  --radius-xs:   4px;
  --radius-sm:   6px;
  --radius-md:   8px;   /* small buttons, chips */
  --radius-lg:   12px;  /* desktop buttons, form fields */
  --radius-xl:   16px;  /* cards */
  --radius-2xl:  20px;
  --radius-3xl:  24px;
  --radius-full: 9999px;

  /* ======================================================================
     SHADOWS — "Soft weather" elevation
     Black at low alpha, larger blur than offset, no tint. Elevation is
     rare — only for menus, sheets, and the pill CTA hover lift.
     ====================================================================== */
  --shadow-xs:  0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-sm:  0 2px 8px rgba(0, 0, 0, 0.05);
  --shadow-md:  0 5px 20px rgba(0, 0, 0, 0.08);
  --shadow-lg:  0 8px 32px rgba(0, 0, 0, 0.10);
  --shadow-xl:  0 16px 48px rgba(0, 0, 0, 0.12);
  --shadow-focus: 0 0 0 3px rgba(63, 122, 239, 0.25);

  /* iOS-kit task-specific shadow recipes — added 2026-05-27.
     fab   = floating icon buttons, FABs, pill-island tabbar.
     sheet = bottom-up modal sheets (negative y so the shadow lifts up). */
  --shadow-fab:   0 5px 8px rgba(0, 0, 0, 0.08);
  --shadow-sheet: 0 -2px 30px rgba(0, 0, 0, 0.08);

  /* ======================================================================
     SPACING — 4px grid
     ====================================================================== */
  --space-0:  0px;
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  12px;
  --space-4:  16px;
  --space-5:  20px;
  --space-6:  24px;
  --space-7:  32px;
  --space-8:  40px;
  --space-9:  48px;
  --space-10: 56px;
  --space-11: 64px;
  --space-12: 80px;
  --space-13: 96px;
  --space-14: 120px;

  /* ======================================================================
     MOTION
     Cloaked motion is calm. 150-250ms, ease-out for most, spring only
     on sheet entry and the CTA press rebound.
     ====================================================================== */
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in:  cubic-bezier(0.7, 0, 0.84, 0);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ======================================================================
     SEMANTIC TYPOGRAPHY
     Use these instead of literals. `letter-spacing` is tight because
     STK Bureau Sans and SF Pro both look better that way.
     ====================================================================== */
  --display-xl:    700 72px/1.02 var(--font-brand);
  --display-lg:    700 56px/1.05 var(--font-brand);
  --display-md:    700 40px/1.1  var(--font-brand);

  --editorial-xl:  400 72px/1.05 var(--font-serif);
  --editorial-lg:  400 48px/1.1  var(--font-serif);
  --editorial-md:  400 32px/1.15 var(--font-serif);

  --h1:            700 34px/40px var(--font-brand);
  --h2:            700 28px/34px var(--font-brand);
  --h3:            600 22px/28px var(--font-brand);
  --h4:            600 18px/24px var(--font-brand);
  --h5:            600 16px/22px var(--font-brand);

  --body-lg:       400 18px/26px var(--font-brand);
  --body:          400 16px/22px var(--font-brand);
  --body-sm:       400 14px/20px var(--font-brand);
  --body-xs:       400 12px/16px var(--font-brand);

  --label-lg:      500 16px/20px var(--font-brand);
  --label:         500 14px/18px var(--font-brand);
  --label-sm:      500 12px/16px var(--font-brand);

  --caption:       400 12px/16px var(--font-brand);
  --overline:      600 11px/14px var(--font-brand);

  --mono-sm:       400 13px/18px var(--font-mono);
  --mono:          400 14px/20px var(--font-mono);

  --tracking-tight:  -0.02em;
  --tracking-normal: 0;
  --tracking-wide:   0.01em;
  --tracking-caps:   0.08em;
}

/* ==========================================================================
   Baseline element styles — opt in by adding `cds-prose` to a container.
   ========================================================================== */
.cds-prose { font: var(--body); color: var(--fg-muted); }
.cds-prose h1 { font: var(--h1); color: var(--fg-strong); letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-4); }
.cds-prose h2 { font: var(--h2); color: var(--fg-strong); letter-spacing: var(--tracking-tight); margin: var(--space-8) 0 var(--space-3); }
.cds-prose h3 { font: var(--h3); color: var(--fg-strong); margin: var(--space-6) 0 var(--space-2); }
.cds-prose p  { margin: 0 0 var(--space-4); }
.cds-prose code { font: var(--mono-sm); background: var(--bg-muted); padding: 2px 6px; border-radius: var(--radius-xs); }
</style><style>@keyframes cloakedfill{0%{transform:scale(1, 1)}50%{transform:scale(1.2, 1.2)}100%{transform:scale(1, 1)}}.cloaked-fill-animation{animation:cloakedfill 200ms ease-in-out 0ms 1}@media(prefers-reduced-motion){.cloaked-fill-animation{animation:none}}

