.stApp {
    background:
        radial-gradient(
            circle at 85% 5%,
            rgba(34, 211, 238, 0.09),
            transparent 35%
        ),
        #080F1D;
}

.block-container {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 1500px;
}

h1, h2, h3 {
    color: #E6EDF7;
    letter-spacing: -0.025em;
}

[data-testid="stSidebar"] {
    background: #0D1727;
    border-right: 1px solid #223249;
}

[data-testid="stMetric"] {
    background: linear-gradient(
        145deg,
        #142238,
        #0C1728
    );
    border: 1px solid #263A54;
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.18);
}

[data-testid="stMetricLabel"] {
    color: #8EA5BF;
}

[data-testid="stMetricValue"] {
    color: #F1F7FF;
}

div[data-testid="stDataFrame"] {
    border: 1px solid #263A54;
    border-radius: 12px;
    overflow: hidden;
}

.brand {
    font-size: 2.3rem;
    font-weight: 850;
    letter-spacing: -0.06em;
    color: #F0F7FF;
}

.brand span {
    color: #22D3EE;
}

.eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #22D3EE;
    margin-bottom: 8px;
}

.subtitle {
    color: #8EA5BF;
    font-size: 0.95rem;
    margin-bottom: 22px;
}

.status-pill {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 20px;
    background: rgba(34, 197, 94, 0.10);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #86EFAC;
    font-size: 0.75rem;
    font-weight: 700;
}

.rack-scene {
    perspective: 900px;
    padding: 35px 20px 45px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 370px;
    background:
        radial-gradient(
            ellipse at center,
            rgba(34, 211, 238, 0.08),
            transparent 65%
        );
    border: 1px solid #243750;
    border-radius: 18px;
}

.rack {
    width: 245px;
    padding: 18px;
    background: linear-gradient(
        110deg,
        #1B2C43,
        #0C1524 65%
    );
    border: 7px solid #354961;
    border-radius: 10px;
    box-shadow:
        18px 18px 0 #07101C,
        25px 28px 35px rgba(0,0,0,0.6),
        inset 0 0 18px rgba(0,0,0,0.6);
    transform: rotateY(-13deg) rotateX(3deg);
}

.rack-header {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: #8EA5BF;
    text-align: center;
    margin-bottom: 15px;
}

.server-unit {
    background: linear-gradient(
        180deg,
        #263A53,
        #142135
    );
    border: 1px solid #46607B;
    border-radius: 5px;
    padding: 14px 12px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 10px rgba(0,0,0,0.35);
}

.server-name {
    font-size: 0.68rem;
    font-weight: 700;
    color: #D8E7F8;
}

.server-led {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 10px currentColor;
}

.led-green {
    background: #22C55E;
    color: #22C55E;
}

.led-red {
    background: #EF4444;
    color: #EF4444;
}

.led-amber {
    background: #F59E0B;
    color: #F59E0B;
}

.panel {
    background: #101C2E;
    border: 1px solid #263A54;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 16px;
}

.panel-title {
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    color: #8EA5BF;
    margin-bottom: 10px;
}

.panel-value {
    font-size: 1.25rem;
    font-weight: 750;
    color: #F1F7FF;
}

